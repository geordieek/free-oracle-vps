server {
    listen {{ ports.http }};
    listen [::]:{{ ports.http }};
    server_name {{ subdom }}.{{ domain }};

    {# Optional: restrict direct origin access to Cloudflare only (IP allowlist) #}
    {% if nginx_cloudflare_allowlist | default(false) %}
    # Cloudflare networks (auto-generated include with allow ...; deny all;)
    include /etc/nginx/conf.d/cloudflare-ips.conf;
    {% endif %}

    location / {
        proxy_pass          http://127.0.0.1:{{ port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}
